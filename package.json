{
	"name": "rpg-audio",
	"version": "0.6.0",
	"description": "Play audio tracks for tabletop RPG sessions directly from your Obsidian notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"generate:emoji": "node scripts/generate-emoji-data.mjs",
		"check:emoji-data": "node scripts/generate-emoji-data.mjs --check",
		"dev": "npm run check:emoji-data && node esbuild.config.mjs",
		"build": "npm run check:emoji-data && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "npm run check:emoji-data && node test.config.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"emojibase-data": "17.0.0",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"obsidian": "latest"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
